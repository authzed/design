{
  "family": "AuthZed Display",
  "cssVar": "--font-headline",
  "stack": "'AuthZed Display', 'Inter', system-ui, sans-serif",
  "minSizePx": 32,
  "weights": {
    "setup": 300,
    "land": 600,
    "range": [
      300,
      600
    ]
  },
  "widths": {
    "condensed": 82,
    "normal": 100,
    "wide": 115,
    "cssProperty": "font-stretch"
  },
  "license": "OFL-1.1",
  "files": {
    "variable": {
      "woff2": "fonts/AuthZedDisplay[wdth,wght].woff2",
      "ttf": "fonts/AuthZedDisplay[wdth,wght].ttf"
    },
    "static": {
      "82": {
        "300": "fonts/AuthZedDisplay-CondensedLight.ttf",
        "600": "fonts/AuthZedDisplay-CondensedSemiBold.ttf"
      },
      "100": {
        "300": "fonts/AuthZedDisplay-Light.ttf",
        "600": "fonts/AuthZedDisplay-SemiBold.ttf"
      },
      "115": {
        "300": "fonts/AuthZedDisplay-WideLight.ttf",
        "600": "fonts/AuthZedDisplay-WideSemiBold.ttf"
      }
    }
  }
}